{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "iGenius Memory",
  "version": "0.2.0",
  "identifier": "com.igenius-memory.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "iGenius Memory",
        "width": 380,
        "height": 720,
        "minWidth": 320,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "startMenuFolder": "iGenius Memory"
      }
    }
  }
}
